PORT=3000
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Bucket Storage (igual evoluxbote: `resumes`).
SUPABASE_STORAGE_BUCKET=resumes

# Se o bucket for privado, use "1" para gravar em file_url uma URL assinada (abre no navegador durante o TTL).
# SUPABASE_STORAGE_SIGNED_URL=1
# TTL em segundos (padrão 31536000 ≈ 1 ano).
# SUPABASE_STORAGE_SIGNED_TTL_SEC=31536000
