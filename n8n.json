      "id": "c1dbdd27-207e-4a01-a4fa-2748cae5f4d1",
      "name": "Consultar Jobs API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-220, 140]
    },
    {
      "parameters": {
        "functionCode": "const jobsResp = $input.first().json || {};\nconst original = $('Tem Palavra Vaga?').first().json;\n\nconst jobs = Array.isArray(jobsResp.jobs) ? jobsResp.jobs : [];\nconst resumo = jobs.length\n  ? jobs.slice(0, 10).map((j, i) => `${i + 1}. ${j.title || j.job_title || 'Vaga sem titulo'}${j.location ? ' - ' + j.location : ''}`).join('\\n')\n  : 'Sem vagas listadas no momento.';\n\nconst enriched = `${original.chatInput}\\n\\n[CONTEXTO_JOBS]\\n${resumo}`;\n\nreturn [{\n  json: {\n    ...original,\n    history: [\n      {\n        role: 'system',\n        content: 'Use as vagas do bloco [CONTEXTO_JOBS] para responder de forma objetiva e convidar o candidato para o site evoluxrh.com.br.'\n      }\n    ],\n    chatInput: enriched\n  }\n}];"
      },
      "id": "ba92ec4c-f884-4ec6-a44c-e1ce3f5c39de",
      "name": "Injetar Contexto Vagas",
