        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatInput: $json.chatInput, phone: $json.phone, sessionId: $json.sessionId, history: $json.history || [] }) }}",
        "options": {}
