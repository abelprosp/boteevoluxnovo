    {
      "parameters": {
        "functionCode": "const body = $json.body || {};\nconst content = body.content || {};\nconst contact = body.contact || {};\n\nconst rawMessage = content.text || content.body || body.message || body.chatInput || '';\nlet phone = String(contact.number || body.phone || '').replace(/\\D/g, '');\nif (!phone) return [{ json: { ignore: true } }];\nif (!phone.startsWith('55')) phone = '55' + phone;\n\nconst chatInput = String(rawMessage || '').trim();\nif (!chatInput) return [{ json: { ignore: true } }];\n\nreturn [{ json: { ignore: false, phone, sessionId: phone, chatInput, history: [] } }];"
      },
