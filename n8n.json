      "id": "cedaf33c-8c41-4a4d-b39b-b81de0b47f95",
      "name": "Chamar API IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [260, 260]
    },
    {
      "parameters": {
        "functionCode": "const item = $input.first().json;\nconst mychatPayload = item.mychatPayload || {};\nconst number = String(mychatPayload.number || item.phone || '').replace(/\\D/g, '');\nconst body = String(mychatPayload.body || item.message || '').replace(/[\\r\\n]+/g, ' ').trim();\nif (!number || !body) throw new Error('Resposta da API IA sem number/body');\n\nreturn [{ json: {\n  number,\n  body,\n  externalKey: mychatPayload.externalKey || `lead_${number}`,\n  isClosed: mychatPayload.isClosed === true\n} }];"
      },
      "id": "e8363d10-97f2-4836-a2c8-f6e5f6f2807d",
